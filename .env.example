# Copy this file to .env and fill in real values. .env is git-ignored -
# never commit real secrets.

# Required - the app refuses to start without this. Used to authenticate
# POST/GET /runs requests (Authorization: Bearer <value>).
PROSPECTFORGE_API_KEY=replace-with-a-long-random-value

# Matches docker-compose.yml's default Postgres credentials for local dev.
# Override in any real deployment.
DATABASE_URL=postgresql+psycopg://prospectforge:prospectforge@localhost:5432/prospectforge

LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional at the app level (the app still boots and /health still works
# without it) - required only when a run actually tries to use the real
# Apollo discovery provider. Get one from https://app.apollo.io -> Settings
# -> API.
APOLLO_API_KEY=

# How many organizations a single discovery run pulls by default (100 per
# page). Kept conservative given Apollo's free tier.
DISCOVERY_MAX_RESULTS=100

# "csv" (default) or "apollo". Defaults to csv because Apollo's free plan
# has no search API access - see ADR-003's addendum. Switch to "apollo"
# once real API access exists (requires APOLLO_API_KEY above).
DISCOVERY_PROVIDER=csv

# Optional at the app level, same reasoning as APOLLO_API_KEY - required
# only when a run tries to use the real Claude web-search research
# provider (Step 11). Get one from https://console.anthropic.com.
ANTHROPIC_API_KEY=

# "csv" (default) or "apollo". Apollo's people-search endpoint is gated on
# the free plan - see ADR-003's addendum (re-confirmed at Step 12).
PEOPLE_DISCOVERY_PROVIDER=csv
PEOPLE_DISCOVERY_PERSONA_ID=primary-buyer-v1

# "csv" (default) or "apollo". Apollo's people/match (contact enrichment)
# endpoint is also gated on the free plan - re-confirmed at Step 13.
CONTACT_ENRICHMENT_PROVIDER=csv

# "deterministic" (default) or "anthropic". The qualification verdict
# itself is always 100% deterministic regardless of this setting - it
# only controls how the rationale text is phrased. See Step 15's
# correction and qualification/service.py.
QUALIFICATION_RATIONALE_PROVIDER=deterministic

# Optional at the app level, same reasoning as APOLLO_API_KEY - required
# only when CRM sync (Step 18) actually tries to reach the real HubSpot
# adapter. A HubSpot private app token (Settings -> Integrations ->
# Private Apps in a HubSpot developer/sandbox account), not an OAuth
# client secret.
HUBSPOT_API_KEY=

# Optional at the app level, same reasoning as every other API key -
# Sentry error tracking (Step 22) is simply disabled without it. Get one
# from https://sentry.io (free tier) -> Settings -> Projects -> Client
# Keys (DSN).
SENTRY_DSN=
